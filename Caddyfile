{$DOMAIN_NAME:localhost} {
    encode gzip zstd

    @backend {
        path /api/* /uploads/* /health /docs /openapi.json /redoc
    }
    handle @backend {
        reverse_proxy backend:8000
    }

    handle /admin {
        rewrite * /abscode-command-center.html
        reverse_proxy frontend:80
    }

    handle {
        reverse_proxy frontend:80
    }
}
